generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  password      String
  role          UserRole  @default(CUSTOMER)
  address       String?
  city          String?
  district      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings           Booking[]
  seatHolds          SeatHold[]
  authTokens         AuthToken[]
  voucherRedemptions VoucherRedemption[]
}

/// Token dùng cho quên mật khẩu / xác thực email
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // PASSWORD_RESET | EMAIL_VERIFY
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Cinema {
  id      String @id @default(cuid())
  name    String
  city    String
  address String

  halls Hall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hall {
  id       String @id @default(cuid())
  cinemaId String
  name     String
  capacity Int

  layoutWidth  Int    @default(1000)
  layoutHeight Int    @default(650)
  layoutPreset String @default("STANDARD")

  cinema Cinema @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  showtimes    Showtime[]
  seats        Seat[]
  layoutBlocks HallLayoutBlock[]

  @@index([cinemaId])
}

model Seat {
  id     String @id @default(cuid())
  hallId String

  code       String
  rowLabel   String
  seatNumber Int

  type String @default("STANDARD")

  isActive Boolean @default(true)

  positionX Int @default(0)
  positionY Int @default(0)

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  tickets   Ticket[]
  seatHolds SeatHold[]

  @@unique([hallId, code])
  @@index([hallId, positionY])
  @@index([hallId, positionX])
}

model HallLayoutBlock {
  id     String @id @default(cuid())
  hallId String

  type String

  x      Int
  y      Int
  width  Int
  height Int

  label String?

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@index([hallId])
}

model Movie {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  genre        String
  duration     Int
  ageRating    String
  synopsis     String   @db.Text
  posterUrl    String   @db.Text
  imageUrl     String   @db.Text
  trailerUrl   String?  @db.Text
  releaseDate  DateTime
  isNowShowing Boolean  @default(true)
  isComingSoon Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showtimes Showtime[]
}

model Showtime {
  id        String   @id @default(cuid())
  movieId   String
  hallId    String
  startTime DateTime
  endTime   DateTime

  language String @default("VietSub")
  format   String @default("2D")

  standardPrice Int @default(85000)
  vipPrice      Int @default(100000)
  couplePrice   Int @default(160000)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hall  Hall  @relation(fields: [hallId], references: [id], onDelete: Cascade)

  bookings  Booking[]
  seatHolds SeatHold[]
}

model Booking {
  id         String @id @default(cuid())
  userId     String
  showtimeId String

  bookingCode String @unique

  customerName  String
  customerPhone String
  customerEmail String
  note          String?

  paymentMethod String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  totalPrice     Int
  subtotalPrice  Int     @default(0)
  discountAmount Int     @default(0)
  voucherId      String?
  refundedAmount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  tickets           Ticket[]
  payment           Payment?
  seatHolds         SeatHold[]
  voucher           Voucher?           @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  combos            BookingCombo[]
  voucherRedemption VoucherRedemption?
}

model Voucher {
  id             String   @id @default(cuid())
  code           String   @unique
  discountType   String   @default("FIXED")
  discountValue  Int
  minOrderAmount Int      @default(0)
  usageLimit     Int?
  usedCount      Int      @default(0)
  perUserLimit   Int      @default(1)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings    Booking[]
  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  bookingId String   @unique
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([voucherId, userId])
}

model Combo {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings BookingCombo[]
}

model BookingCombo {
  id          String       @id @default(cuid())
  bookingId   String
  comboId     String
  quantity    Int          @default(1)
  unitPrice   Int
  qrCode      String?      @unique
  status      TicketStatus @default(ACTIVE)
  checkedInAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([comboId])
  @@index([qrCode])
}

model Ticket {
  id        String  @id @default(cuid())
  bookingId String
  seatId    String
  seatCode  String
  price     Int
  qrCode    String?

  status      TicketStatus @default(ACTIVE)
  canceledAt  DateTime?
  checkedInAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)
}

model Payment {
  id        String @id @default(cuid())
  bookingId String @unique

  provider        String
  transactionCode String?
  amount          Int
  status          String    @default("PENDING")
  paidAt          DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionCode])
  @@index([status])
}

model SeatHold {
  id String @id @default(cuid())

  seatId     String
  showtimeId String
  bookingId  String?
  userId     String

  expiresAt DateTime
  createdAt DateTime @default(now())

  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seatId, showtimeId])
  @@index([expiresAt])
  @@index([showtimeId])
  @@index([userId])
  @@index([bookingId])
}
