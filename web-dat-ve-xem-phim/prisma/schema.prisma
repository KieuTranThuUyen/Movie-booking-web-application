generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  CANCELED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(CUSTOMER)
  address   String?
  city      String?
  district  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  seatHolds SeatHold[]
}

model Cinema {
  id      String @id @default(cuid())
  name    String
  city    String
  address String

  halls Hall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hall {
  id       String @id @default(cuid())
  cinemaId String
  name     String
  capacity Int

  layoutWidth  Int    @default(1000)
  layoutHeight Int    @default(650)
  layoutPreset String @default("STANDARD")

  cinema Cinema @relation(fields: [cinemaId], references: [id], onDelete: Cascade)

  showtimes    Showtime[]
  seats        Seat[]
  layoutBlocks HallLayoutBlock[]

  @@index([cinemaId])
}

model Seat {
  id     String @id @default(cuid())
  hallId String

  code       String
  rowLabel   String
  seatNumber Int

  type String @default("STANDARD")

  isActive Boolean @default(true)

  positionX Int @default(0)
  positionY Int @default(0)

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  tickets   Ticket[]
  seatHolds SeatHold[]

  @@unique([hallId, code])
  @@index([hallId, positionY])
  @@index([hallId, positionX])
}

model HallLayoutBlock {
  id     String @id @default(cuid())
  hallId String

  type String

  x      Int
  y      Int
  width  Int
  height Int

  label String?

  hall Hall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@index([hallId])
}

model Movie {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  genre        String
  duration     Int
  ageRating    String
  synopsis     String   @db.Text
  posterUrl    String   @db.Text
  imageUrl     String   @db.Text
  trailerUrl   String?  @db.Text
  releaseDate  DateTime
  isNowShowing Boolean  @default(true)
  isComingSoon Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showtimes Showtime[]
}

model Showtime {
  id        String   @id @default(cuid())
  movieId   String
  hallId    String
  startTime DateTime
  endTime   DateTime

  language String @default("VietSub")
  format   String @default("2D")

  standardPrice Int @default(85000)
  vipPrice      Int @default(100000)
  couplePrice   Int @default(160000)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hall  Hall  @relation(fields: [hallId], references: [id], onDelete: Cascade)

  bookings  Booking[]
  seatHolds SeatHold[]
}

model Booking {
  id         String  @id @default(cuid())
  userId     String?
  showtimeId String

  bookingCode String @unique

  customerName  String
  customerPhone String
  customerEmail String
  note          String?

  paymentMethod String

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  totalPrice     Int
  refundedAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  tickets   Ticket[]
  payment   Payment?
  seatHolds SeatHold[]
}

model Ticket {
  id        String  @id @default(cuid())
  bookingId String
  seatId    String
  seatCode  String
  price     Int
  qrCode    String?

  status     TicketStatus @default(ACTIVE)
  canceledAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)
}

model Payment {
  id        String @id @default(cuid())
  bookingId String @unique

  provider        String
  transactionCode String?
  amount          Int
  status          String    @default("PENDING")
  paidAt          DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([provider, transactionCode])
  @@index([status])
}

model SeatHold {
  id String @id @default(cuid())

  seatId     String
  showtimeId String
  bookingId  String?
  userId     String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([seatId, showtimeId])
  @@index([expiresAt])
  @@index([showtimeId])
  @@index([userId])
  @@index([bookingId])
}
