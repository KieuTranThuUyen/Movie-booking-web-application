DATABASE_URL="mysql://root:root@localhost:3306/cinema_booking"

# Bắt buộc – tạo chuỗi ngẫu nhiên dài (≥32 ký tự)
# Ví dụ: openssl rand -base64 32
NEXTAUTH_SECRET="thay_bang_chuoi_ngau_nhien_dai"
NEXTAUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrator"

# URL app (dùng cho link reset MK, xác thực email, payment callback)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =========================================================
# SePay - SANDBOX
# =========================================================
SEPAY_ENV="sandbox"
SEPAY_MERCHANT_ID=""          # lấy từ SePay Dashboard
SEPAY_SECRET_KEY=""           # lấy từ SePay Dashboard
SEPAY_WEBHOOK_SECRET=""       # nên đặt ở production; sandbox có thể để trống nếu code cho phép
SEPAY_PAYMENT_PREFIX="MOVIE"

# =========================================================
# Email (tuỳ chọn – không có thì link in ra console khi dev)
# =========================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="noreply@example.com"
APP_NAME="Cinema Booking"

# =========================================================
# Google OAuth (tuỳ chọn)
# =========================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""